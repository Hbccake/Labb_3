<Window x:Class="Labb_3.Dialogs.CreateNewPackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Labb_3.Dialogs"
        ResizeMode="NoResize"
WindowStyle="ToolWindow"
        mc:Ignorable="d"
        Title="New Question Pack" Height="225" Width="200">

    
        <StackPanel Margin="5">
           
        <Label Content="Pack Name:" FontWeight="Bold"/>
        <TextBox Text="PackName" />
        <Label Content="Difficulty:" FontWeight="Bold"/>
        <ComboBox x:Name="difficultyComboBox" Text="{Binding Difficulty}"/>
        <StackPanel Orientation="Horizontal" >
            <Label Content="Time Limit:" FontWeight="Bold"/>
            <Label Content="{Binding ActivePack.TimeLimitInSeconds, Mode=OneWay}" Margin="50 0 " VerticalAlignment="Center"/>
        </StackPanel>

        <Slider x:Name="timeSlider"
              Minimum="0"
              Maximum="120"
              Value="{Binding ActivePack.TimeLimitInSeconds}"
              IsSnapToTickEnabled="true"
                TickFrequency="5"
          TickPlacement="BottomRight"
          />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            
        <Button Content="Cancel" Margin="10"/>
                <Button Content="Create" Margin="10"/>
        </StackPanel>

        </StackPanel>
   
</Window>
