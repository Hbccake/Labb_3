<Window x:Class="Labb_3.Dialogs.PackOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Labb_3.Dialogs"
        
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        mc:Ignorable="d"
        Title="Pack Options" Height="220" Width="200" >
   
    
    <StackPanel Margin="10 10 10 0">
    
        
        <Label Content="Pack Name:" FontWeight="Bold"/>
        <TextBox Text="{Binding ActivePack.Name}"/>
        <Label Content="Difficulty:" FontWeight="Bold"/>
        <ComboBox 
            ItemsSource="{Binding ConfigurationViewModel.Difficulties}"
                  SelectedValue="{Binding ConfigurationViewModel.SelectedDifficulty}"

                  >
              
             
        </ComboBox>
                  
        <StackPanel Orientation="Horizontal" >
            <Label Content="Time Limit:" FontWeight="Bold"/>
            <Label Content="{Binding ActivePack.TimeLimitInSeconds, Mode=OneWay}" Margin="50 0 " VerticalAlignment="Center"/>
        </StackPanel>
        <Slider x:Name="timeSlider"
                Minimum="0"
                Maximum="120"
                Value="{Binding ActivePack.TimeLimitInSeconds}"
                TickFrequency="5"
                IsSnapToTickEnabled="true"
            TickPlacement="BottomRight"
            />

    </StackPanel>
</Window>
