<Window x:Class="Labb_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Labb_3"
        xmlns:views="clr-namespace:Labb_3.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="800">
    <Window.InputBindings>
        <KeyBinding  Key="N" Modifiers="Ctrl"  Command="{Binding ConfigurationViewModel.OpenCreateNewPackDialogCommand}"/>
        <KeyBinding  Key="O" Modifiers="Ctrl"  Command="{Binding ConfigurationViewModel.LoadQuestionPackCommand}"/>
        <KeyBinding  Key="S" Modifiers="Ctrl"  Command="{Binding ConfigurationViewModel.SaveQuestionPackCommand}"/>
        <KeyBinding  Key="I" Modifiers="Ctrl"  Command="{Binding ConfigurationViewModel.ChangePackCommand}"/>
        <KeyBinding  Key="F4" Modifiers="Alt"  Command="{Binding ConfigurationViewModel.ChangePackCommand}"/>
        <KeyBinding  Key="Insert"   Command="{Binding ConfigurationViewModel.AddQuestionCommand}"/>
        <KeyBinding  Key="Delete"   Command="{Binding ConfigurationViewModel.RemoveQuestionCommand}"/>
        <KeyBinding  Key="P" Modifiers="Ctrl"  Command="{Binding PlayerViewModel.StartQuizCommand}"/>
        <KeyBinding  Key="E" Modifiers="Ctrl"  Command="{Binding ConfigurationViewModel.ChangePackCommand}"/>
        <KeyBinding  Key="Enter" Modifiers="Alt"  Command="{Binding ConfigurationViewModel.ChangePackCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
    </Window.Resources>
    
    <Grid ShowGridLines="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
      
        
        <views:MenuView Grid.Row="0"/>
        <views:PlayerView Grid.Row="1" Visibility="{Binding DataContext.IsActiveQuiz, 
            RelativeSource={RelativeSource AncestorType={x:Type Window}},
            Converter={StaticResource BooleanToVisibility}}"/>
        <views:ConfigurationView Grid.Row="1" Visibility="{Binding DataContext.IsConfigurationViewVisible,
            RelativeSource={RelativeSource AncestorType={x:Type Window}},
            Converter={StaticResource BooleanToVisibility}}" />
        <views:QuizEndView Grid.Row="1" Visibility="{Binding DataContext.ShowEndView,
            RelativeSource={RelativeSource AncestorType={x:Type Window}},
            Converter={StaticResource BooleanToVisibility}}"/>
    </Grid>
</Window>
