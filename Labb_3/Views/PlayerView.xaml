<UserControl x:Class="Labb_3.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Labb_3.Views"
             mc:Ignorable="d" 
             
             d:DesignHeight="450" d:DesignWidth="800">
   
    
    <Grid ShowGridLines="True" DataContext="{Binding PlayerViewModel}">
        <Grid.Resources>
            <SolidColorBrush x:Key="Buttoncolour" Color="LightGray">
                
            </SolidColorBrush>
            <Style TargetType="Button">
                
                <Setter Property="Background" Value="LightGray"/>
                <Setter Property="BorderBrush" Value="Black"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Margin" Value="10"/>
            </Style>

        </Grid.Resources>
        <!--<Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>-->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

       

                    <StackPanel  Grid.Row="0" Orientation="Vertical" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" >
            <TextBlock  Text="{Binding CurrentQuestion.Query}" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
            <StackPanel Grid.Row="0" VerticalAlignment="Bottom" Margin="20" >
      
                        <Label HorizontalAlignment="Center" FontSize="15" Content="{Binding QuestionCount}"/>
            </StackPanel>
            

        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5">

            <TextBlock Text="{Binding RemainingTime}" Margin="10" FontSize="20" FontWeight="Bold"/>
        </StackPanel>



        <StackPanel  Grid.Row="1" Margin="5">
            <StackPanel  Margin="10"  Orientation="Horizontal"  HorizontalAlignment="Center"  VerticalAlignment="Top">
                <Button Content="{Binding Answer1}" Margin="5" Height="70" Width="200"/>
                <Button Content="{Binding Answer2}" Margin="5" Height="70" Width="200"/>
            </StackPanel>
        <StackPanel  Margin="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" >

                <Button Content="{Binding Answer3}" Margin="5" Height="70" Width="200"/>
                <Button Content="{Binding Answer4}" Margin="5" Height="70" Width="200"/>
            </StackPanel>

        </StackPanel>

      


    </Grid>
</UserControl>
